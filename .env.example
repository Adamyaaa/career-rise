# Copy this file to .env at the repo root and fill in real values for local dev.
# Used by both docker-compose.yml and apps/api (NestJS ConfigModule reads it from the repo root).

NODE_ENV=development

# --- Postgres (also used by docker-compose to init the container) ---
POSTGRES_USER=career_rise
POSTGRES_PASSWORD=career_rise_dev
POSTGRES_DB=career_rise
POSTGRES_PORT=5432
DATABASE_URL=postgresql://career_rise:career_rise_dev@localhost:5432/career_rise?schema=public

# --- Database Seeding ---
# Required for running `npm run prisma:seed`. Set to a strong, secure password in production!
SEED_PASSWORD=your_secure_password_here

# --- Redis ---
# If 6379 is already taken by another local project, remap the host port here
# (and in REDIS_URL) — the container's internal port stays 6379 either way.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- JWT ---
# REQUIRED: generate two DIFFERENT secrets, min 32 chars. Never reuse these values —
# anyone who has them can forge a token for any user. Run this twice:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# The API refuses to boot with NODE_ENV=production if either still looks like a
# placeholder, or if the two match (see apps/api/src/config/env.validation.ts).
JWT_ACCESS_SECRET=change-me-generate-a-real-secret
JWT_REFRESH_SECRET=change-me-generate-a-different-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Email (login OTP codes, via Brevo) ---
# Optional. Leave BREVO_API_KEY unset for local dev and the API logs the OTP to the
# server console instead of emailing it (and returns it in the response) — set it and
# codes are emailed for real, and never returned by the API.
#
# Brevo needs only a verified SENDER ADDRESS, not a domain, so this works without
# owning a domain:
#   1. Sign up at https://www.brevo.com (free tier: 300 emails/day)
#   2. Senders, Domains & Dedicated IPs -> Senders -> Add a sender, then click the
#      confirmation link Brevo emails you
#   3. SMTP & API -> API Keys -> Generate a new API key
# MAIL_FROM must match the sender address you verified.
BREVO_API_KEY=
MAIL_FROM="Career Rise <hello@iagentlabs.com>"

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
