// Career Rise — Prisma schema
//
// Transcribed from the approved Phase 1-3 design doc, with additions called out
// in the Phase 4 plan (see /plans — "Decisions Requiring Explicit Sign-off"):
//   - explicit @relation fields on both sides of every FK (doc only listed scalar columns)
//   - `cohortId` denormalized onto Evidence and Attendance, mirroring ProgressSignal,
//     so cohort-scoped reads don't require a 3-4 hop join
//   - FK convention: `studentId` / `Review.mentorId` / `Attendance.markedBy` reference
//     User.id (the acting user); `CohortMentorAssignment.mentorProfileId` references
//     MentorProfile.id (capacity/specialization matching, not an actor)
//   - `deliveryType`/`deliveryConfig`, `evidenceType`/`metadata`, `signalType` stay as
//     plain strings/Json per the doc's polymorphic-via-registry design (no enums, no
//     table-per-type) — validated at the app layer against a DeliveryTypeRegistry /
//     EvidenceTypeRegistry, not by the database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  SUPER_ADMIN
}

model User {
  id    String @id @default(cuid())
  email String @unique
  // Admin-provisioned accounts (mentors, other admins) never get a usable password —
  // this holds an unusable placeholder hash and they sign in with an emailed OTP.
  passwordHash String
  role         Role
  // Soft deactivation. Login and OTP both refuse inactive accounts, so access is
  // revoked without deleting their cohort history, feedback or progress.
  isActive     Boolean @default(true)
  // Nullable because accounts predating these fields — and OTP sign-ups, which only
  // ever supply an email — have no name. The UI falls back to the email prefix.
  firstName    String?
  lastName     String?
  phone        String?
  createdAt    DateTime @default(now())

  studentProfile StudentProfile?
  mentorProfile  MentorProfile?

  enrollments       CohortEnrollment[]
  evidence          Evidence[]
  reviews           Review[]
  progressSignals   ProgressSignal[]
  attendances       Attendance[]       @relation("AttendanceStudent")
  markedAttendances Attendance[]       @relation("AttendanceMarkedBy")
  lessonCompletions LessonCompletion[]
  lessonFeedback    LessonFeedback[]   @relation("FeedbackStudent")
  announcements     Announcement[]     @relation("AnnouncementAuthor")

  @@map("users")
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model MentorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  specializations String[]
  capacity        Int

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortAssignments CohortMentorAssignment[]

  @@map("mentor_profiles")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String[]

  cohorts Cohort[]

  @@map("courses")
}

model Cohort {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  startDate DateTime
  endDate   DateTime

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrollments           CohortEnrollment[]
  mentorAssignments     CohortMentorAssignment[]
  modules               Module[]
  reviewCriteria        ReviewCriterion[]
  progressWeightConfigs ProgressWeightConfig[]
  progressSignals       ProgressSignal[]
  evidence              Evidence[]
  attendances           Attendance[]
  lessonCompletions     LessonCompletion[]
  lessonFeedback        LessonFeedback[]
  announcements         Announcement[]

  @@index([courseId])
  @@map("cohorts")
}

model CohortEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  cohortId   String
  status     String   @default("active") // active | withdrawn
  enrolledAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([studentId, cohortId])
  @@index([cohortId])
  @@map("cohort_enrollments")
}

model CohortMentorAssignment {
  id              String @id @default(cuid())
  cohortId        String
  mentorProfileId String

  cohort        Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@unique([cohortId, mentorProfileId])
  @@map("cohort_mentor_assignments")
}

model Module {
  id       String @id @default(cuid())
  cohortId String
  title    String
  order    Int
  // No date here on purpose: a module is a container, and its span is derived from the
  // scheduledAt of the classes inside it.

  cohort  Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([cohortId])
  @@map("modules")
}

model Lesson {
  id        String    @id @default(cuid())
  moduleId  String
  title     String
  content   String
  order     Int
  slidesUrl String? // link to the previous class's slides (e.g. Google Drive) — mentor/admin-set, link only, no file upload
  assignmentsUrl String? // link to the assignment material
  // When this class runs — date *and* time. Whether a class has happened is derived from
  // this rather than stored per student. Null means unscheduled.
  scheduledAt DateTime?
  // Mentor-set: this class expects the student to hand work in. Drives the denominator of
  // the `evidence_submitted` progress signal, so it is deliberately explicit rather than
  // inferred from whether an assignment link happens to be attached.
  submissionRequired Boolean @default(false)
  // A class that was called off. Whether a class has been taught is otherwise derived from
  // the clock — a scheduled class whose time has passed was taught — so cancelling is the
  // only thing a mentor needs to record, rather than ticking every class as delivered.
  cancelled Boolean @default(false)

  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sessions    LearningSession[]
  evidence    Evidence[]
  completions LessonCompletion[]
  feedback    LessonFeedback[]

  @@index([moduleId])
  @@map("lessons")
}

model LearningSession {
  id             String    @id @default(cuid())
  lessonId       String
  deliveryType   String // e.g. "classroom" | "webinar" | "self_paced" — validated against DeliveryTypeRegistry
  deliveryConfig Json
  scheduledAt    DateTime?
  durationMins   Int?

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([lessonId])
  @@map("learning_sessions")
}

model Attendance {
  id                String   @id @default(cuid())
  learningSessionId String
  studentId         String
  cohortId          String // denormalized from the session's lesson->module->cohort chain; see header note
  status             String   // present | absent | late | excused
  markedAt          DateTime @default(now())
  markedBy          String

  learningSession LearningSession @relation(fields: [learningSessionId], references: [id], onDelete: Cascade)
  student         User            @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  markedByUser    User            @relation("AttendanceMarkedBy", fields: [markedBy], references: [id])
  cohort          Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([learningSessionId, studentId])
  @@index([studentId, cohortId])
  @@index([cohortId])
  @@map("attendance")
}

model Evidence {
  id           String   @id @default(cuid())
  studentId    String
  lessonId     String
  cohortId     String // denormalized from the lesson->module->cohort chain; see header note
  evidenceType String // e.g. "github_repo" | "pdf" | "figma" | "drive_link" | "video" — validated against EvidenceTypeRegistry
  storageKey   String? // file-based
  externalUrl  String? // link-based
  metadata     Json
  submittedAt  DateTime @default(now())
  status       String   @default("submitted")

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  review  Review?

  @@index([studentId, cohortId])
  @@index([cohortId])
  @@map("evidence")
}

// Student-marked "done/not done" per lesson — self-reported, distinct from Evidence
// (proof-of-work review). Presence of a row = done; the toggle endpoints create/delete
// it rather than storing a boolean, so completedAt only means something when it exists.
model LessonCompletion {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  cohortId    String // denormalized from the lesson->module->cohort chain; see header note
  completedAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, cohortId])
  @@map("lesson_completions")
}

// A note from a mentor or admin to a whole cohort: a heading, some body text, and an
// optional link (slides, a form, a recording). Replaced file uploads, which wrote to
// the API container's own disk and so were lost on every redeploy.
model Announcement {
  id        String   @id @default(cuid())
  cohortId  String
  authorId  String
  title     String
  content   String
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  author User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cohortId, createdAt])
  @@map("announcements")
}

// One-way feedback from a student to the cohort's mentors about a specific class.
// Deliberately not a conversation: the student never sees it again after sending, and
// mentors read it in their own Feedback tab rather than replying.
model LessonFeedback {
  id        String   @id @default(cuid())
  lessonId  String
  cohortId  String // denormalized from the lesson->module->cohort chain; see header note
  studentId String
  body      String
  createdAt DateTime @default(now())

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student User   @relation("FeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([cohortId, createdAt])
  @@index([lessonId])
  @@map("lesson_feedback")
}

model ReviewCriterion {
  id       String @id @default(cuid())
  cohortId String
  name     String
  weight   Float  @default(1.0)
  order    Int

  cohort       Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  reviewScores ReviewScore[]

  @@index([cohortId])
  @@map("review_criteria")
}

model Review {
  id             String   @id @default(cuid())
  evidenceId     String   @unique
  mentorId       String
  overallComment String?
  createdAt      DateTime @default(now())

  evidence Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  mentor   User          @relation(fields: [mentorId], references: [id])
  scores   ReviewScore[]

  @@map("reviews")
}

model ReviewScore {
  id          String  @id @default(cuid())
  reviewId    String
  criterionId String
  score       Int
  comment     String?

  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion ReviewCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  // Schema-level guard against duplicate criterion scores on one review.
  // The "all active criteria must be scored" rule itself is app-layer (Reviews module),
  // checked before a Review is allowed to be created.
  @@unique([reviewId, criterionId])
  @@map("review_scores")
}

model ProgressSignal {
  id         String   @id @default(cuid())
  studentId  String
  cohortId   String
  signalType String // e.g. "attendance" | "evidence_submitted" | "review_score" | "quiz_score"
  value      Float // normalized 0-1
  computedAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([studentId, cohortId])
  @@index([cohortId])
  @@map("progress_signals")
}

model ProgressWeightConfig {
  id         String @id @default(cuid())
  cohortId   String
  signalType String
  weight     Float

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, signalType])
  @@map("progress_weight_configs")
}

